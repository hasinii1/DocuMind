# ==============================================================================
# DocuMind AI Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=documind_secret_development_key_change_in_production

# Backend Service
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL + pgvector or local fallback)
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# For Local Docker: postgresql://postgres:postgres@localhost:5432/documind
DATABASE_URL=sqlite:///./documind.db
USE_PGVECTOR=false

# Supabase (Optional for auth and cloud object storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=documind-documents

# Local File Storage (when Supabase Storage is not configured)
LOCAL_STORAGE_DIR=./storage/uploads

# LLM Provider (Google Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Embeddings
EMBEDDING_PROVIDER=sentence-transformers # options: sentence-transformers, gemini, local-tfidf
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Cross-Encoder Reranker
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKER=true

# Processing & Rate Limiting
MAX_UPLOAD_SIZE_MB=50
MAX_PAGES_PER_DOCUMENT=200
DEFAULT_CHUNK_SIZE_TOKENS=600
DEFAULT_CHUNK_OVERLAP_TOKENS=100
